{
    "id": "com.magazineautomation.panel",
    "name": "Magazine Automation",
    "version": "1.1.0",
    "main": "index.html",
    "manifestVersion": 5,
    "host": {
        "app": "ID",
        "minVersion": "18.5.0"
    },
    "entrypoints": [
        {
            "type": "panel",
            "id": "magazineAutomationPanel",
            "label": {
                "default": "Magazine Automation"
            },
            "minimumSize": {
                "width": 430,
                "height": 500
            },
            "maximumSize": {
                "width": 2000,
                "height": 2000
            },
            "preferredDockedSize": {
                "width": 450,
                "height": 850
            },
            "preferredFloatingSize": {
                "width": 520,
                "height": 900
            }
        }
    ],
    "requiredPermissions": {
        "localFileSystem": "fullAccess",
        "clipboard": "readAndWrite",
        "network": {
            "domains": [
                "https://api.openai.com"
            ]
        }
    }
}
